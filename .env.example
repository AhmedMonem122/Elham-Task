# Copy to .env and fill in — never commit the real file.
# Neon (cloud Postgres): paste the pooled connection string from the Neon dashboard.
# Example: postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.neon.tech/neondb?sslmode=require"

# Test database (separate Neon DB/branch recommended so tests can wipe it).
# If unset, tests fall back to DATABASE_URL (NOT recommended).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.neon.tech/neondb_test?sslmode=require"

# Server port (local dev). Vercel injects its own PORT.
PORT=3000
